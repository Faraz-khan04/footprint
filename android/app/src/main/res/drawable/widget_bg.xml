<?xml version="1.0" encoding="utf-8"?>
<!-- Ink, with the same faint grid the dashboard uses, and a hairline edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#151515" />
            <corners android:radius="18dp" />
            <stroke android:width="1dp" android:color="#2A2D2B" />
        </shape>
    </item>
    <item>
        <bitmap android:src="@drawable/widget_grid" android:tileMode="repeat" android:alpha="0.5" />
    </item>
</layer-list>
